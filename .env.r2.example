# Backend only. Merge these names into your local, ignored .env; do not replace it.
# mongodb stores local private bytes; r2 uses R2 for NEW private HRMS documents.
HRMS_DOCUMENT_STORAGE=mongodb
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hrms-private-dev
# Optional; normally derived from R2_ACCOUNT_ID. Use the bucket's S3 API endpoint.
R2_ENDPOINT=

# Never enable public access (r2.dev/custom public domain) on private HR documents.
# No frontend credentials, public URL or browser CORS rules are needed.
